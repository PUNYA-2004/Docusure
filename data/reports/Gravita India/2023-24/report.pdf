    <script type="text/javascript">

        var Is_validExp = "^(?=.*[~`^<>:;.!])";
        function submit_md_click() {
          
            //  alert($('#text_search').val());
            if ($('#text_search').val() == "") {
                alert("Please enter search keyword")
                return false;
            }

            else if ($('#text_search').val().match(Is_validExp)) {
                alert("Please enter valid characters. The following characters are not accepted ` ~ ^ < > : ; . !");
                return false;
            }
            else {
                // alert("in search");
                //window.location = "www.tata.com";
                window.location = "/search/" + $('#text_search').val();
                // window.location.replace("/search/" + $('#text_search').val());
            }

        }
        function submit_xs_click() {
            if ($('#text_xs').val() == "") {
                alert("Please enter search keyword")
                return false;
            }
            else if ($('#text_xs').val().match(Is_validExp)) {
                alert("Please enter valid characters. The following characters are not accepted ` ~ ^ < > : ; . !");
                return false;
            }
            else {
                window.location = "/search/" + $('#text_xs').val();
            }

        }

        function keyDownSubmit() {
            if (event.keycode == 13) {
                document.getelementbyid('submit_md').click();
            }
        }


       


        function key1() {
            if (validateSearch()) {
                window.location = "/search/" + $('#text_search').val();
                return true;
            }
        }


        function clickBtn(e) {
            if (window.event) // IE
            {
                //alert('in');
                if (e.keyCode == 13) {
                    if (validateSearch1()) {
                        // alert('hi');
                        
                        window.location = "/search/" + $('#text_search').val();
                        // document.getElementById('text_search').blur();
                        return false;
                    }
                }
            }
            else if (e.which) // Netscape/Firefox/Opera
            {

                if (e.which == 13) {
                    if (validateSearch1()) {
                        window.location = "/search/" + $('#text_search').val();
                        // document.getElementById('txtSearch1').blur();
                        return false;
                    }
                }
            }
        }
        function validateSearch() {
            if ($('#text_search').val() == "Search" || $('#text_search').val() == "") {
                alert("Please enter search keywords");
                return false;
            }
            else {
                var Is_validExp = "^(?=.*[~`^<>:;.!])";
                if ($('#text_search').val().match(Is_validExp)) {
                    alert("Please enter valid characters. The following characters are not accepted ` ~ ^ <script > : ; . !");
                    return false;
                }

            }

            return true;

        }
    </script>
    

    
